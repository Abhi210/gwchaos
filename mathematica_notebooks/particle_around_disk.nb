Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Example", " ", "initial", " ", "conditions", " ", "and", " ", "time"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ics", "=", 
     RowBox[{"{", 
      RowBox[{
      "1.2", ",", "0.0", ",", "0.0", ",", "0.0", ",", "0.76", ",", "L"}], 
      "}"}]}], ";"}], "  ", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "random", " ", "normal", " ", "values", " ", "for", " ", 
     "w", 
     RowBox[{"(", "0", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", "6"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Normalize", " ", "w", 
     RowBox[{"(", "0", ")"}], " ", "to", " ", "make", " ", "it", " ", "a", 
     " ", "unitary", " ", "vector"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"w0", "/", 
      RowBox[{"Norm", "[", "w0", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "u0", " ", "and", " ", "w0", " ", "into", " ", "a", " ", 
     "single", " ", "flattened", " ", "vector"}], "*)"}], "\n", 
   RowBox[{"Y0", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"{", 
      RowBox[{"ics", ",", "w0"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Call", " ", "the", " ", "chaoticLyp", " ", "function"}], "*)"}], 
   "\n", 
   RowBox[{"chaoticLyp", "[", 
    RowBox[{"t", ",", "Y0", ",", "alpha"}], "]"}]}]}]], "Input",
