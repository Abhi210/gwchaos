Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"showOrbit", "[", 
    RowBox[{"sol_", ",", "patt_", ",", "f_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "orbit", ",", "x", ",", "z"}], "}"}], ",", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"First", "[", "sol", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"n", "\[GreaterEqual]", "3"}], ",", 
        RowBox[{
         RowBox[{"orbit", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"n", "\[Equal]", "3"}], "&&", 
             RowBox[{"patt", "\[Equal]", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]}], ",", "sol", ",", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "patt", "]"}], "]"}], "&"}], ",", "sol"}], 
             "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"Graphics3D", "[", 
            RowBox[{"f", "[", "orbit", "]"}], "]"}], ",", 
           RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], ",", 
        RowBox[{"n", "\[Equal]", "2"}], ",", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"f", "[", "orbit", "]"}], "]"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], ",", 
        RowBox[{"n", "\[Equal]", "1"}], ",", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"Map", "[", 
           RowBox[{"First", ",", "sol"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"z", "=", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Drop", "[", 
              RowBox[{"x", ",", 
               RowBox[{"-", "1"}]}], "]"}], ",", 
             RowBox[{"Drop", "[", 
              RowBox[{"x", ",", "1"}], "]"}]}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"Graphics", "[", 
            RowBox[{"f", "[", "z", "]"}], "]"}], ",", 
           RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PhaseSpaceC", "[", 
    RowBox[{"f_", ",", "initcond_", ",", "time_", ",", 
     RowBox[{"trans_:", "0"}], ",", 
     RowBox[{"stepsize_:", "0.02"}], ",", 
     RowBox[{"patt_:", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "a", ",", "x", ",", "x0", ",", "sol"}], "}"}], ",", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "initcond", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"a", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"RKPoint", "[", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "initcond", ",", 
         RowBox[{"{", 
          RowBox[{"trans", ",", "stepsize"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"RKList", "[", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "x0", ",", 
         RowBox[{"{", 
          RowBox[{"time", ",", "stepsize"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"showOrbit", "[", 
       RowBox[{"sol", ",", "patt", ",", "Line"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rossler", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "y"}], "-", "z"}], ",", " ", 
     RowBox[{"x", "+", 
      RowBox[{"0.25", " ", "y"}], "+", "w"}], ",", " ", 
     RowBox[{"3", " ", "+", " ", 
      RowBox[{"x", " ", "z"}]}], ",", " ", 
     RowBox[{
      RowBox[{"0.05", " ", "w"}], " ", "-", " ", 
      RowBox[{"0.5", " ", "z"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "10"}], ",", 
     RowBox[{"-", "14"}], ",", "0.3", ",", "29"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", " ", "=", " ", "0.1"}], ";", " ", 
  RowBox[{"K", " ", "=", " ", "2000"}], ";", " ", 
  RowBox[{"TR", "=", "1"}], ";", "  ", 
  RowBox[{"stepsize", "=", "0.02"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"lcesrossler", " ", "=", " ", 
  RowBox[{"LCEsC", "[", 
   RowBox[{
   "rossler", ",", "x0", ",", " ", "T", ",", " ", "K", ",", " ", "TR", ",", 
