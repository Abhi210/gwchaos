Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LyapunovDimension", "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", "suml", ",", "j"}], "}"}], ",", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"x", ",", "Greater"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"suml", "=", 
       RowBox[{"Rest", "[", 
        RowBox[{"FoldList", "[", 
         RowBox[{"Plus", ",", "0", ",", "l"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "[", "suml", "]"}], ">", "0"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{"LCE", "::", "pos"}], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j", "=", 
       RowBox[{"Last", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"suml", ",", 
          RowBox[{"_", "?", "Positive"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"First", "[", 
       RowBox[{"j", "-", 
        RowBox[{
         RowBox[{"suml", "[", 
          RowBox[{"[", "j", "]"}], "]"}], "/", 
         RowBox[{"l", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LCEsC", "[", 
    RowBox[{"f_", ",", "initcond_", ",", "T_", ",", "K_", ",", 
     RowBox[{"trans_:", "0"}], ",", 
     RowBox[{"stepsize_:", "0.02"}], ",", "opts___Rule"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "opt", ",", "n", ",", "a", ",", "b", ",", "x", ",", "x0", ",", "Phi", 
       ",", "DPhi", ",", "V0", ",", "s", ",", "W", ",", "norms", ",", 
       "lcelist", ",", "lces"}], "}"}], ",", 
     RowBox[{
      RowBox[{"opt", "=", 
       RowBox[{
        RowBox[{"LCEsPlot", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Options", "[", "LCEsC", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "initcond", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"a", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Phi", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Array", "[", 
         RowBox[{"b", ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DPhi", "=", 
       RowBox[{"Phi", ".", 
        RowBox[{"Transpose", "[", 
         RowBox[{"JacobianMtx", "[", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"Nest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RKStep", "[", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "#", ",", 
            RowBox[{"N", "[", "stepsize", "]"}]}], "]"}], "&"}], ",", 
         RowBox[{"N", "[", "initcond", "]"}], ",", 
         RowBox[{"Round", "[", 
          RowBox[{"N", "[", 
           RowBox[{"trans", "/", "stepsize"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"V0", "=", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x0", ",", "V0"}], "}"}], "=", 
          RowBox[{"IntVarEq", "[", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], ",", "DPhi", ",", "x", ",", "Phi", 
            ",", "x0", ",", "V0", ",", 
            RowBox[{"{", 
             RowBox[{"T", ",", "stepsize"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"W", "=", 
          RowBox[{"GramSchm", "[", "V0", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"norms", "=", 
          RowBox[{"Map", "[", 
           RowBox[{"Norm", ",", "W"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"s", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"s", ",", "norms"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"V0", "=", 
          RowBox[{"W", "/", "norms"}]}]}], ",", 
        RowBox[{"{", "K", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"opt", ",", 
        RowBox[{
         RowBox[{"lcelist", "=", 
          RowBox[{
           RowBox[{"Rest", "[", 
            RowBox[{"FoldList", "[", 
             RowBox[{"Plus", ",", "0", ",", 
              RowBox[{"Log", "[", "s", "]"}]}], "]"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"T", " ", 
             RowBox[{"Range", "[", "K", "]"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"ConvergencePlot", "[", "lcelist", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"lces", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Apply", "[", 
              RowBox[{"Plus", ",", 
               RowBox[{"Log", "[", "s", "]"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"T", " ", "K"}], ")"}]}], ",", "Greater"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"lces", ",", 
            RowBox[{"LyapunovDimension", "[", "lces", "]"}]}], "}"}], 
          "]"}]}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"LCEsC", "[", 
  RowBox[{"F", ",", " ", 
   RowBox[{"{", 
    RowBox[{"19", ",", " ", "20", ",", " ", "50"}], "}"}], ",", " ", "0.1", 
   ",", " ", "800", ",", " ", "20", ",", " ", "0.02", ",", " ", 
   RowBox[{"LCEsPlot", "\[Rule]", "False"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"LCEsC", "[", 
  RowBox[{"F", ",", " ", 
   RowBox[{"{", 
    RowBox[{"19", ",", " ", "20", ",", " ", "50"}], "}"}], ",", " ", "0.1", 
   ",", " ", "800", ",", " ", "20", ",", " ", "0.02", ",", " ", 
   RowBox[{"LCEsPlot", "\[Rule]", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.8745537156260204`*^9, 3.8745537195794115`*^9}, {
   3.8745554198529625`*^9, 3.8745554520795155`*^9}, {3.874555513360883*^9, 
   3.874555514579752*^9}, {3.8745555903651543`*^9, 3.874555599762209*^9}, 
