           RowBox[{"alpha", "*", 
            RowBox[{"Tanh", "[", 
             RowBox[{"z", "/", "z0"}], "]"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dpphi", "=", "0.0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
