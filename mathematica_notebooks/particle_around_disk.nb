Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "logcosh", " ", "function"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"logcosh", "[", "x_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "p"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Compute", " ", "s", " ", "and", " ", "p", " ", "similar", " ", "to", 
         " ", 
         RowBox[{"Python", "'"}], "s", " ", 
         RowBox[{"np", ".", "sign"}], " ", "and", " ", 
         RowBox[{"np", ".", "exp"}]}], "*)"}], 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{"Sign", "[", "x", "]"}], "*", "x"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "s"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Return", " ", "the", " ", "result", " ", "of", " ", "the", " ", 
          "logcosh", " ", "function"}], "*)"}], 
        RowBox[{"s", "+", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", "p"}], "]"}], "-", 
         RowBox[{"Log", "[", "2", "]"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "H", " ", "function"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"mu_", ",", "ics_", ",", "alpha_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi", ",", 
         "L", ",", "M", ",", "z0"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "If", " ", "ics", " ", "is", " ", "a", " ", "1", "D", " ", "array"}],
          ",", 
         RowBox[{"unpack", " ", "values", " ", "accordingly"}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ArrayDepth", "[", "ics", "]"}], "==", "1"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], 
            "}"}], "=", "ics"}], ",", 
          RowBox[{"(*", 
           RowBox[{"Otherwise", ",", 
            RowBox[{"assume", " ", 
             RowBox[{"it", "'"}], "s", " ", "a", " ", "2", "D", " ", "array", 
             " ", "and", " ", "unpack", " ", "columns"}]}], "*)"}], 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], 
            "}"}], "=", 
           RowBox[{"Transpose", "[", "ics", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Assign", " ", "constants"}], "*)"}], 
        RowBox[{"L", "=", "pphi"}], ";", "\[IndentingNewLine]", 
        RowBox[{"M", "=", "1."}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Example", " ", "value"}], ",", 
          RowBox[{
          "you", " ", "can", " ", "replace", " ", "it", " ", "if", " ", 
           "needed"}]}], "*)"}], 
        RowBox[{"z0", "=", "0.5"}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Example", " ", "value"}], ",", 
          RowBox[{
          "you", " ", "can", " ", "replace", " ", "it", " ", "if", " ", 
           "needed"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
         "Return", " ", "the", " ", "result", " ", "of", " ", "the", " ", 
          "Hamiltonian"}], "*)"}], 
        RowBox[{"mu", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"pw", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "mu"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"pz", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "mu"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"L", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", 
              RowBox[{"mu", "^", "2"}], "*", 
              RowBox[{"w", "^", "2"}]}], ")"}]}], "-", 
           RowBox[{"M", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"w", "^", "2"}], "+", 
              RowBox[{"z", "^", "2"}]}], "]"}]}], "+", 
           RowBox[{"alpha", "*", "z0", "*", 
            RowBox[{"logcosh", "[", 
             RowBox[{"z", "/", "z0"}], "]"}]}]}], ")"}]}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.935213449733803*^9, 3.935213449734168*^9}, {
  3.9352141313725853`*^9, 3.935214140927288*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"099b1d32-1062-497a-8d51-d8be112627be"],

