Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "function", " ", "to", " ", "evolve", " ", "the", " ", 
    "system"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"evolve", "[", 
     RowBox[{"t_", ",", "x_", ",", "alpha_", ",", "z0_", ",", "M_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi", ",", 
        "dw", ",", "dz", ",", "dphi", ",", "dpw", ",", "dpz", ",", "dpphi"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], 
         "}"}], "=", "x"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Calculate", " ", "derivatives"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dw", "=", "pw"}], ";", "\[IndentingNewLine]", 
       RowBox[{"dz", "=", "pz"}], ";", "\[IndentingNewLine]", 
       RowBox[{"dphi", "=", 
        RowBox[{"pphi", "/", 
         RowBox[{"(", 
          RowBox[{"mu", "*", 
           RowBox[{"w", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dpw", "=", 
        RowBox[{
         RowBox[{"-", "mu"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"pphi", "^", "2"}]}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"mu", "^", "2"}], "*", 
              RowBox[{"w", "^", "3"}]}], ")"}]}], "+", 
           RowBox[{"M", "*", 
            RowBox[{"w", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"w", "^", "2"}], "+", 
                 RowBox[{"z", "^", "2"}]}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}]}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"dpz", "=", 
        RowBox[{
         RowBox[{"-", "mu"}], "*", 
