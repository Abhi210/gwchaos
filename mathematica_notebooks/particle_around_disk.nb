Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "t", ",", "usol", ",", "X1t", ",", "w", ",", "z", ",", "pw", ",", "pz", 
    ",", "pphi", ",", "dw", ",", "dz", ",", "dphi", ",", "dpw", ",", "dpz", 
    ",", "dpphi"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "chaotic_lyp", " ", "function", " ", "in", " ", 
    "Mathematica"}], "*)"}], 
  RowBox[{
   RowBox[{"chaoticLyp", "[", 
    RowBox[{"t_", ",", "Y_", ",", "alpha_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi", ",", 
       "dfw", ",", "dfz", ",", "dfphi", ",", "dfpw", ",", "dfpz", ",", 
       "dfpphi", ",", "dfhdwdw", ",", "dfhdwdz", ",", "dfhdzdz", ",", "J", 
       ",", "dY", ",", "dYdt"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Unpack", " ", "Y"}], "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], "}"}],
        "=", 
       RowBox[{"Take", "[", 
        RowBox[{"Y", ",", "6"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"System", " ", "of", " ", "differential", " ", "equations"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dfw", "=", "pw"}], ";", "\[IndentingNewLine]", 
      RowBox[{"dfz", "=", "pz"}], ";", "\[IndentingNewLine]", 
      RowBox[{"dfphi", "=", 
       RowBox[{"L", "/", 
        RowBox[{"(", 
         RowBox[{"mu", "*", 
          RowBox[{"w", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dfpw", "=", 
       RowBox[{
        RowBox[{"-", "mu"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"L", "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"mu", "^", "2"}], "*", 
             RowBox[{"w", "^", "3"}]}], ")"}]}], "+", 
          RowBox[{"M", "*", 
           RowBox[{"w", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w", "^", "2"}], "+", 
                RowBox[{"z", "^", "2"}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dfpz", "=", 
       RowBox[{
        RowBox[{"-", "mu"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"M", "*", 
           RowBox[{"z", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w", "^", "2"}], "+", 
                RowBox[{"z", "^", "2"}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}]}], "+", 
          RowBox[{"alpha", "*", 
           RowBox[{"Tanh", "[", 
            RowBox[{"z", "/", "z0"}], "]"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dfpphi", "=", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Jacobian", " ", "matrix", " ", "elements"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dfhdwdw", "=", 
       RowBox[{
        RowBox[{"-", "mu"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "*", 
           RowBox[{
            RowBox[{"L", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"mu", "^", "2"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"w", "^", "4"}], ")"}]}], ")"}]}]}], "-", 
          RowBox[{"3", "*", "M", "*", 
           RowBox[{
            RowBox[{"w", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w", "^", "2"}], "+", 
                RowBox[{"z", "^", "2"}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"5", "/", "2"}], ")"}]}], ")"}]}]}], "+", 
          RowBox[{"M", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"w", "^", "2"}], "+", 
               RowBox[{"z", "^", "2"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dfhdwdz", "=", 
       RowBox[{"3", "*", "M", "*", "mu", "*", "w", "*", 
        RowBox[{"z", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"w", "^", "2"}], "+", 
             RowBox[{"z", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"5", "/", "2"}], ")"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dfhdzdz", "=", 
       RowBox[{
        RowBox[{"-", "mu"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], "*", "M", "*", 
           RowBox[{
            RowBox[{"z", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w", "^", "2"}], "+", 
                RowBox[{"z", "^", "2"}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"5", "/", "2"}], ")"}]}], ")"}]}]}], "+", 
          RowBox[{"M", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"w", "^", "2"}], "+", 
               RowBox[{"z", "^", "2"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}], "+", 
          RowBox[{"alpha", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sech", "[", 
               RowBox[{"z", "/", "z0"}], "]"}], "^", "2"}], ")"}], "/", 
            "z0"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Jacobian", " ", "matrix"}], "*)"}], 
      RowBox[{"J", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "0.", ",", "0.", ",", "0.", ",", "1.", ",", "0.", ",", "0."}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "0.", ",", "0.", ",", "0.", ",", "0.", ",", "1.", ",", "0."}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2."}], "*", 
            RowBox[{"L", "/", 
             RowBox[{"(", 
              RowBox[{"mu", "*", 
               RowBox[{"w", "^", "3."}]}], ")"}]}]}], ",", "0.", ",", "0.", 
           ",", "0.", ",", "0.", ",", 
           RowBox[{"1.", "/", 
            RowBox[{"(", 
             RowBox[{"mu", "*", 
              RowBox[{"w", "^", "2."}]}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "dfhdwdw", ",", "dfhdwdz", ",", "0.", ",", "0.", ",", "0.", ",", 
           RowBox[{"2.", "*", 
            RowBox[{"L", "/", 
             RowBox[{"(", 
              RowBox[{"mu", "*", 
               RowBox[{"w", "^", "3."}]}], ")"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "dfhdwdz", ",", "dfhdzdz", ",", "0.", ",", "0.", ",", "0.", ",", 
           "0."}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "0.", ",", "0.", ",", "0.", ",", "0.", ",", "0.", ",", "0."}], 
          "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Extract", " ", "dY", " ", "and", " ", "reshape"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dY", "=", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Drop", "[", 
          RowBox[{"Y", ",", "6"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Compute", " ", "dY_dt"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dYdt", "=", 
       RowBox[{"J", ".", "dY"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Concatenate", " ", "the", " ", "results", " ", "and", " ", "return", 
        " ", "the", " ", "final", " ", "output"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "dfw", ",", "dfz", ",", "dfphi", ",", "dfpw", ",", "dfpz", ",", 
          "dfpphi"}], "}"}], ",", 
        RowBox[{"Flatten", "[", "dYdt", "]"}]}], "]"}]}]}], 
    "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.935475960409707*^9, 3.935475961586383*^9}, {
  3.935476528909192*^9, 3.935476603084587*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"f2f91d92-0812-4b6a-bea8-19d9613bc2cd"],

