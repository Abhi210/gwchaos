Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "the", " ", "differential", " ", "equation", " ", "system"}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sol", ",", "pointsData"}], "}"}], "=", 
    RowBox[{"Reap", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"(*", 
         RowBox[{"System", " ", "of", " ", "differential", " ", "equations"}],
          "*)"}], 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"D", "[", 
