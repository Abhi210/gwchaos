Cell[BoxData[
 RowBox[{
  RowBox[{"FevolveLyap", "[", 
   RowBox[{
   "ics0_", ",", "tau_", ",", "tf_", ",", "alpha_", ",", "z0_", ",", "M_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "timestep", ",", "size", ",", "X1t", ",", "sum", ",", "compiledFunc", 
      ",", "evolveStep"}], "}"}], ",", 
    RowBox[{
     RowBox[{"timestep", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", "tf", ",", "tau"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"size", "=", 
      RowBox[{"Length", "[", "timestep", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"X1t", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"size", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"compiledFunc", "="}], 
       RowBox[{"(*", 
        RowBox[{
        "Define", " ", "the", " ", "compiled", " ", "function", " ", "here", 
         " ", "as", " ", "in", " ", "your", " ", "code"}], "*)"}], ";"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Define", " ", "a", " ", "single", " ", "evolution", " ", "step"}], 
      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"sum", "=", "0."}], ";", 
     RowBox[{
      RowBox[{"evolveStep", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ics_", ",", "sum_"}], "}"}], ",", "time_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "usol", ",", "xk", ",", "wk", ",", "alphak", ",", "wk0", ",", "h"}], 
         "}"}], ",", 
        RowBox[{
         RowBox[{"usol", "=", 
          RowBox[{"NDSolveValue", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"EQ9", "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\[CapitalMu]", "->", "M"}], ",", 
                   RowBox[{"z", "->", "z0"}], ",", 
                   RowBox[{"\[Alpha]", "->", "alpha"}]}], "}"}]}], ",", 
                RowBox[{"EQ3", "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\[CapitalMu]", "->", "M"}], ",", 
                   RowBox[{"z", "->", "z0"}], ",", 
                   RowBox[{"\[Alpha]", "->", "alpha"}]}], "}"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "1"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "2"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "3"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "4"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "5"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "5", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "6"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "6", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "7"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "7", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "8"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "8", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "9"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "9", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "10"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "10", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "11"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "11", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  SubscriptBox["y", "12"], "[", "0", "]"}], "\[Equal]", 
                 RowBox[{"ics", "[", 
                  RowBox[{"[", "12", "]"}], "]"}]}]}], 
               RowBox[{"(*", 
                RowBox[{",", 
                 RowBox[{"WhenEvent", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{"t", ",", "tau"}], "]"}], "==", "0."}], ",", 
                   RowBox[{"Print", "[", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    SubscriptBox["y", "7"], "[", "t", "]"}], ",", 
                    RowBox[{
                    SubscriptBox["y", "8"], "[", "t", "]"}], ",", 
                    RowBox[{
                    SubscriptBox["y", "9"], "[", "t", "]"}], ",", 
                    RowBox[{
                    SubscriptBox["y", "10"], "[", "t", "]"}], ",", 
                    RowBox[{
                    SubscriptBox["y", "11"], "[", "t", "]"}], ",", 
                    RowBox[{
                    SubscriptBox["y", "12"], "[", "t", "]"}]}], "}"}], "]"}], 
                    "]"}]}], "]"}]}], "*)"}], "}"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SubscriptBox["y", "1"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "2"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "3"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "4"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "5"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "6"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "7"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "8"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "9"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "10"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "11"], "[", "time", "]"}], ",", 
              RowBox[{
               SubscriptBox["y", "12"], "[", "time", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"time", "-", "50"}], ",", "time"}], "}"}], ",", 
            RowBox[{"Method", "->", 
             RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", 
            RowBox[{"AccuracyGoal", "->", "12"}], ",", 
            RowBox[{"PrecisionGoal", "->", "12"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Extract", " ", "results", " ", "and", " ", "compute"}], 
          "*)"}], 
         RowBox[{"xk", "=", 
          RowBox[{"Take", "[", 
           RowBox[{"usol", ",", "6"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"wk", "=", 
          RowBox[{"Drop", "[", 
           RowBox[{"usol", ",", "6"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"alphak", "=", 
          RowBox[{"Norm", "[", "wk", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"sum", "=", 
            RowBox[{"sum", "+", 
             RowBox[{"Log", "[", "alphak", "]"}]}]}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"wk0", "=", 
          RowBox[{"wk", "/", "alphak"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"xk", ",", "wk0"}], "]"}], ",", 
           RowBox[{"sum", "+", 
            RowBox[{"Log", "[", "alphak", "]"}]}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Use", " ", "FoldList", " ", "to", " ", "propagate", " ", "the", " ", 
       "state"}], "*)"}], 
     RowBox[{"FoldList", "[", 
      RowBox[{"evolveStep", ",", 
       RowBox[{"{", 
        RowBox[{"ics0", ",", "sum"}], "}"}], ",", 
       RowBox[{"Rest", "[", "timestep", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Extract", " ", "the", " ", "Lyapunov", " ", "exponent", " ", 
       "estimates"}], "*)"}], 
     RowBox[{"X1t", "=", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"timestep", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], "]"}], "]"}]}], 
         "&"}], ",", 
        RowBox[{"Rest", "[", 
         RowBox[{"FoldList", "[", 
          RowBox[{"evolveStep", ",", 
           RowBox[{"{", 
            RowBox[{"Y0", ",", "sum"}], "}"}], ",", 
           RowBox[{"Rest", "[", "timestep", "]"}]}], "]"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", "X1t"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.935803942032741*^9, 3.935803967467204*^9}, 
   3.935804027975595*^9, {3.93580417525357*^9, 3.935804193471938*^9}, 
