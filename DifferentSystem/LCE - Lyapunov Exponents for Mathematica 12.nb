Cell[TextData[{
 StyleBox["LCEs of Discrete Systems - p..83\n",
  FontFamily->"Arial",
  FontSize->14,
  FontColor->GrayLevel[1],
  Background->RGBColor[0., 0.5019607843137255, 0.7529411764705882]],
 StyleBox["A four-dimensional discrete-time dynamical system",
  FontFamily->"Arial",
  FontColor->GrayLevel[1]]
}], "Text",
 CellChangeTimes->{{3.497541763203125*^9, 3.497541777125*^9}, {
  3.49754181465625*^9, 3.49754181940625*^9}, {3.49754203934375*^9, 
  3.497542069640625*^9}, {3.8745674028573413`*^9, 3.8745674158592443`*^9}},
 Background->RGBColor[
  0., 0.5019607843137255, 
   0.7529411764705882],ExpressionUUID->"38fd681d-07c7-4fc9-9b7e-3835a09642b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LCEsD", "[", 
    RowBox[{"f_", ",", "initcond_", ",", "K_", ",", 
     RowBox[{"trans_:", "0"}], ",", "opts___Rule"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "opt", ",", "n", ",", "a", ",", "J", ",", "s", ",", "q", ",", "r", ",", 
       "lces"}], "}"}], ",", 
     RowBox[{
      RowBox[{"opt", "=", 
       RowBox[{
        RowBox[{"LCEsPlot", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Options", "[", "LCEsD", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "initcond", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"a", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"J", "[", "y_List", "]"}], ":=", 
       RowBox[{
        RowBox[{"JacobianMtx", "[", 
         RowBox[{
          RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{"x", "\[Rule]", "y"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"Nest", "[", 
        RowBox[{"f", ",", 
         RowBox[{"N", "[", "initcond", "]"}], ",", "trans"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "r"}], "}"}], "=", 
       RowBox[{"QRDecomposition", "[", 
        RowBox[{"J", "[", "x0", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x0", "=", 
          RowBox[{"f", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", ",", "r"}], "}"}], "=", 
          RowBox[{"QRDecomposition", "[", 
           RowBox[{
            RowBox[{"J", "[", "x0", "]"}], ".", 
            RowBox[{"Transpose", "[", "q", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"s", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"s", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"r", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "]"}]}]}], ",", 
        RowBox[{"{", "K", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"opt", ",", 
        RowBox[{
         RowBox[{"lcelist", "=", 
          RowBox[{
           RowBox[{"Rest", "[", 
            RowBox[{"FoldList", "[", 
             RowBox[{"Plus", ",", "0", ",", 
              RowBox[{"Re", "[", 
               RowBox[{"Log", "[", "s", "]"}], "]"}]}], "]"}], "]"}], "/", 
           RowBox[{"Range", "[", "K", "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"ConvergencePlot", "[", "lcelist", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"lces", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Apply", "[", 
               RowBox[{"Plus", ",", 
                RowBox[{"Log", "[", "s", "]"}]}], "]"}], "]"}], "/", "K"}], 
            ",", "Greater"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"lces", ",", 
            RowBox[{"LyapunovDimension", "[", "lces", "]"}]}], "}"}], 
          "]"}]}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"1.85", "-", 
     RowBox[{"z", "^", "2"}], " ", "-", 
     RowBox[{"0.05", "w"}]}], ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"lceshyper2", " ", "=", " ", 
  RowBox[{"LCEsD", "[", 
   RowBox[{"G", ",", 
    RowBox[{"{", 
     RowBox[{"0.1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ", "1000", 
    ",", "100", ",", " ", 
    RowBox[{"LCEsPlot", "\[Rule]", "False"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"LyapunovDimension", "[", 
  RowBox[{"First", "[", "lceshyper2", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{"LCEsD", "[", 
   RowBox[{"G", ",", 
    RowBox[{"{", 
     RowBox[{"0.1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ", "1000", 
    ",", "100", ",", " ", 
    RowBox[{"LCEsPlot", "\[Rule]", "True"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.8745575781340737`*^9, 3.8745575819253087`*^9}, {
   3.8745576170944824`*^9, 3.8745576187821026`*^9}, 3.8745670591036854`*^9, {
   3.874567094755148*^9, 3.8745671362157726`*^9}, {3.8745671773607736`*^9, 
   3.874567227839975*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"e94871e8-f7cc-403a-aec4-2cf2527b3888"],

