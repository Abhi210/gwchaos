Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"logcosh", "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", "p"}], "}"}], ",", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{
        RowBox[{"Sign", "[", "x", "]"}], "*", "x"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], "*", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"s", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "+", "p"}], "]"}], "-", 
       RowBox[{"Log", "[", "2", "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "[", 
   RowBox[{"mu_", ",", "ics_", ",", "alpha_", ",", "z0_", ",", "M_"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi", ",", "L"}],
      "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Check", " ", "if", " ", "input", " ", "is", " ", "a", " ", "vector", 
      " ", 
      RowBox[{"(", 
       RowBox[{"1", "D", " ", "case"}], ")"}], " ", "or", " ", "matrix", " ", 
      
      RowBox[{"(", 
       RowBox[{"2", "D", " ", "case"}], ")"}]}], "*)"}], 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"VectorQ", "[", "ics", "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{"1", "D", " ", "case"}], "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], 
         "}"}], "=", "ics"}], ",", 
       RowBox[{"(*", 
        RowBox[{"2", "D", " ", "case", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "matrix", " ", "where", " ", "each", " ", "row", " ", "is", " ", 
            "a", " ", "phase"}], "-", 
           RowBox[{"space", " ", "coordinate", " ", "set"}]}], ")"}]}], 
        "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], 
         "}"}], "=", 
        RowBox[{"Transpose", "[", "ics", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Define", " ", "L", " ", "in", " ", "terms", " ", "of", " ", "pphi"}], 
      "*)"}], 
     RowBox[{"L", "=", "pphi"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Return", " ", "the", " ", "energy"}], "*)"}], 
     RowBox[{"mu", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"pw", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "mu"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"pz", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "mu"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"L", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"mu", "^", "2"}], "*", 
           RowBox[{"w", "^", "2"}]}], ")"}]}], "-", 
        RowBox[{"M", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"w", "^", "2"}], "+", 
           RowBox[{"z", "^", "2"}]}], "]"}]}], "+", 
        RowBox[{"alpha", "*", "z0", "*", 
         RowBox[{"logcosh", "[", 
          RowBox[{"z", "/", "z0"}], "]"}]}]}], ")"}]}]}]}], "]"}]}]}], "Input",\

