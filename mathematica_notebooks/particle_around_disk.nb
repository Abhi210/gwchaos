Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "function", " ", "to", " ", "evolve", " ", "the", " ", 
    "system"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"evolve", "[", 
     RowBox[{"t_", ",", "x_", ",", "alpha_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi", ",", 
        "dw", ",", "dz", ",", "dphi", ",", "dpw", ",", "dpz", ",", "dpphi"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "w", ",", "z", ",", "phi", ",", "pw", ",", "pz", ",", "pphi"}], 
         "}"}], "=", "x"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Calculate", " ", "derivatives"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dw", "=", "pw"}], ";", "\[IndentingNewLine]", 
       RowBox[{"dz", "=", "pz"}], ";", "\[IndentingNewLine]", 
       RowBox[{"dphi", "=", 
        RowBox[{"L", "/", 
         RowBox[{"(", 
          RowBox[{"mu", "*", 
           RowBox[{"w", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dpw", "=", 
        RowBox[{
         RowBox[{"-", "mu"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"L", "^", "2"}]}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"mu", "^", "2"}], "*", 
              RowBox[{"w", "^", "3"}]}], ")"}]}], "+", 
           RowBox[{"M", "*", 
            RowBox[{"w", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"w", "^", "2"}], "+", 
                 RowBox[{"z", "^", "2"}]}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}]}]}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"dpz", "=", 
        RowBox[{
         RowBox[{"-", "mu"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"M", "*", 
            RowBox[{"z", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"w", "^", "2"}], "+", 
                 RowBox[{"z", "^", "2"}]}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}], ")"}]}]}], "+", 
           RowBox[{"alpha", "*", 
            RowBox[{"Tanh", "[", 
             RowBox[{"z", "/", "z0"}], "]"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dpphi", "=", "0.0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Return", " ", "result", " ", "as", " ", "a", " ", "list", " ", 
         RowBox[{"(", 
          RowBox[{"equivalent", " ", "to", " ", 
           RowBox[{"np", ".", "array"}], " ", "in", " ", "Python"}], ")"}]}], 
        "*)"}], 
       RowBox[{"{", 
        RowBox[{
        "dw", ",", "dz", ",", "dphi", ",", "dpw", ",", "dpz", ",", "dpphi"}], 
        "}"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.93521308067867*^9, 3.935213080678925*^9}, {
  3.935214200710548*^9, 3.9352142308093357`*^9}, {3.935214443419613*^9, 
