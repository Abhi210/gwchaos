Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prj", "[", 
   RowBox[{"v1_", ",", "v2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"v2", ".", "v1"}], ")"}], " ", 
   RowBox[{"v2", "/", 
    RowBox[{"(", 
     RowBox[{"v2", ".", "v2"}], ")"}]}]}]}], "\n", 
 RowBox[{
  RowBox[{"multiprj", "[", 
   RowBox[{"v1_", ",", "vecs_"}], "]"}], ":=", 
  RowBox[{"Plus", "@@", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"prj", "[", 
       RowBox[{"v1", ",", "#"}], "]"}], "&"}], ",", "vecs"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GramSchm", "[", "vecs_", "]"}], ":=", 
    RowBox[{"Fold", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"#1", ",", 
         RowBox[{"{", 
          RowBox[{"#2", "-", 
           RowBox[{"multiprj", "[", 
            RowBox[{"#2", ",", "#1"}], "]"}]}], "}"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", "}"}], ",", "vecs"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhiT", " ", "=", "Phi0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K", "=", "800"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xT", ",", "PhiT"}], "}"}], "=", 
      RowBox[{"IntVarEq", "[", 
       RowBox[{
        RowBox[{"F", "[", "x", "]"}], ",", "DPhi", ",", "x", ",", "Phi", ",", 
        "xT", ",", "PhiT", ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "stepsize"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"W", "=", 
      RowBox[{"GramSchm", "[", "PhiT", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"norms", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"Norm", ",", "W"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"Append", "[", 
       RowBox[{"s", ",", "norms"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"PhiT", "=", 
      RowBox[{"W", "/", "norms"}]}]}], ",", 
    RowBox[{"{", "K", "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lces", "=", 
   RowBox[{
    RowBox[{"Rest", "[", 
     RowBox[{"FoldList", "[", 
      RowBox[{"Plus", ",", "0", ",", 
       RowBox[{"Log", "[", "s", "]"}]}], "]"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"T", " ", 
      RowBox[{"Range", "[", "K", "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Last", "[", "lces", "]"}]}], "Input",
