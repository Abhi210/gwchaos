Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "the", " ", "differential", " ", "equation", " ", "system"}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sol", ",", "points"}], "}"}], "=", 
    RowBox[{"Reap", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"(*", 
         RowBox[{"System", " ", "of", " ", "differential", " ", "equations"}],
          "*)"}], 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"w", "[", "t", "]"}], ",", 
               RowBox[{"z", "[", "t", "]"}], ",", 
               RowBox[{"phi", "[", "t", "]"}], ",", 
               RowBox[{"pw", "[", "t", "]"}], ",", 
               RowBox[{"pz", "[", "t", "]"}], ",", 
               RowBox[{"pphi", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}], "==", 
           RowBox[{"evolve", "[", 
            RowBox[{"t", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"w", "[", "t", "]"}], ",", 
               RowBox[{"z", "[", "t", "]"}], ",", 
               RowBox[{"phi", "[", "t", "]"}], ",", 
               RowBox[{"pw", "[", "t", "]"}], ",", 
               RowBox[{"pz", "[", "t", "]"}], ",", 
               RowBox[{"pphi", "[", "t", "]"}]}], "}"}], ",", "alpha"}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{"Initial", " ", "conditions"}], "*)"}], 
         RowBox[{
          RowBox[{"w", "[", "0", "]"}], "==", 
          RowBox[{"ics", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"z", "[", "0", "]"}], "==", 
          RowBox[{"ics", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"phi", "[", "0", "]"}], "==", 
          RowBox[{"ics", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"pw", "[", "0", "]"}], "==", 
          RowBox[{"ics", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"pz", "[", "0", "]"}], "==", 
          RowBox[{"ics", "[", 
           RowBox[{"[", "5", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"pphi", "[", "0", "]"}], "==", 
          RowBox[{"ics", "[", 
           RowBox[{"[", "6", "]"}], "]"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{"Poincare", " ", "section", " ", "condition"}], "*)"}], 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"z", "[", "t", "]"}], "==", "0"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"pz", "[", "t", "]"}], ">", "0"}]}], ",", " ", 
           RowBox[{"Sow", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], ",", 
              RowBox[{"pz", "[", "t", "]"}]}], "}"}], "]"}]}], "]"}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w", "[", "t", "]"}], ",", 
         RowBox[{"z", "[", "t", "]"}], ",", 
         RowBox[{"phi", "[", "t", "]"}], ",", 
         RowBox[{"pw", "[", "t", "]"}], ",", 
         RowBox[{"pz", "[", "t", "]"}], ",", 
         RowBox[{"pphi", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"tspan", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", 
       RowBox[{"AccuracyGoal", "->", "11"}], ",", 
       RowBox[{"PrecisionGoal", "->", "11"}]}], "]"}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9352142560559387`*^9, 3.9352142560562897`*^9}, {
  3.93521433195037*^9, 3.93521435793758*^9}, {3.935214592080061*^9, 
