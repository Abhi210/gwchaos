Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "t", ",", "usol", ",", "X1t", ",", "w", ",", "z", ",", "pw", ",", "pz", 
     ",", "pphi", ",", "dw", ",", "dz", ",", "dphi", ",", "dpw", ",", "dpz", 
     ",", "dpphi"}], "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Get", " ", "the", " ", "Lyapunov", " ", "Exponent", " ", "of", " ", "the",
     " ", "trajectory"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tau", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"usol", ",", "X1t"}], "}"}], "=", 
   RowBox[{"Reap", "@", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"w", "[", "t", "]"}], ",", 
              RowBox[{"z", "[", "t", "]"}], ",", 
              RowBox[{"phi", "[", "t", "]"}], ",", 
              RowBox[{"pw", "[", "t", "]"}], ",", 
