Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"JacobianMtx", "[", 
    RowBox[{"funs_List", ",", "vars_List"}], "]"}], ":=", 
   RowBox[{"Outer", "[", 
    RowBox[{"D", ",", "funs", ",", "vars"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RKStep", "[", 
    RowBox[{"f_", ",", "y_", ",", "y0_", ",", "dt_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k1", ",", "k2", ",", "k3", ",", "k4"}], "}"}], ",", 
     RowBox[{
      RowBox[{"k1", "=", 
       RowBox[{"dt", " ", 
        RowBox[{"N", "[", 
         RowBox[{"f", "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{"y", "\[Rule]", "y0"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k2", "=", 
       RowBox[{"dt", " ", 
        RowBox[{"N", "[", 
         RowBox[{"f", "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{"y", "\[Rule]", 
            RowBox[{"y0", "+", 
             RowBox[{"k1", "/", "2"}]}]}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k3", "=", 
       RowBox[{"dt", " ", 
        RowBox[{"N", "[", 
         RowBox[{"f", "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{"y", "\[Rule]", 
            RowBox[{"y0", "+", 
             RowBox[{"k2", "/", "2"}]}]}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k4", "=", 
       RowBox[{"dt", " ", 
        RowBox[{"N", "[", 
         RowBox[{"f", "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{"y", "\[Rule]", 
            RowBox[{"y0", "+", "k3"}]}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y0", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k1", "+", 
          RowBox[{"2", " ", "k2"}], "+", 
          RowBox[{"2", " ", "k3"}], "+", "k4"}], ")"}], "/", "6"}]}]}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RKPoint", "[", 
    RowBox[{"f_List", ",", "y_List", ",", "y0_List", ",", 
     RowBox[{"{", 
      RowBox[{"t1_", ",", "dt_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Nest", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RKStep", "[", 
       RowBox[{"f", ",", "y", ",", "#", ",", 
        RowBox[{"N", "[", "dt", "]"}]}], "]"}], "&"}], ",", 
     RowBox[{"N", "[", "y0", "]"}], ",", 
     RowBox[{"Round", "[", 
      RowBox[{"N", "[", 
       RowBox[{"t1", "/", "dt"}], "]"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RKList", "[", 
    RowBox[{"f_List", ",", "y_List", ",", "y0_List", ",", 
     RowBox[{"{", 
      RowBox[{"t1_", ",", "dt_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RKStep", "[", 
       RowBox[{"f", ",", "y", ",", "#", ",", 
        RowBox[{"N", "[", "dt", "]"}]}], "]"}], "&"}], ",", 
     RowBox[{"N", "[", "y0", "]"}], ",", 
     RowBox[{"Round", "[", 
      RowBox[{"N", "[", 
       RowBox[{"t1", "/", "dt"}], "]"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"IntVarEq", "[", 
    RowBox[{
    "F_List", ",", "DPhi_List", ",", "x_List", ",", "Phi_List", ",", 
     "x0_List", ",", "Phi0_List", ",", 
     RowBox[{"{", 
      RowBox[{"t1_", ",", "dt_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "f", ",", "y", ",", "y0", ",", "yt"}], "}"}], ",", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"F", ",", "DPhi"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"x", ",", "Phi"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y0", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"x0", ",", "Phi0"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yt", "=", 
       RowBox[{"Nest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RKStep", "[", 
           RowBox[{"f", ",", "y", ",", "#", ",", 
            RowBox[{"N", "[", "dt", "]"}]}], "]"}], "&"}], ",", 
         RowBox[{"N", "[", "y0", "]"}], ",", 
         RowBox[{"Round", "[", 
          RowBox[{"N", "[", 
           RowBox[{"t1", "/", "dt"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "[", "#", "]"}], ",", 
          RowBox[{"Rest", "[", "#", "]"}]}], "}"}], "&"}], "@", 
       RowBox[{"Partition", "[", 
        RowBox[{"yt", ",", "n"}], "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"16", 
      RowBox[{"(", 
       RowBox[{"y", "-", "x"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"x", 
       RowBox[{"(", 
        RowBox[{"45.92", "-", "z"}], ")"}]}], "-", "y"}], ",", 
     RowBox[{
      RowBox[{"x", " ", "y"}], " ", "-", " ", 
      RowBox[{"4", "z"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"{", 
    RowBox[{"19", ",", "20", ",", "50"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stepsize", "=", "0.02"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   RowBox[{"Length", "[", "x0", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"a", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Phi", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"b", ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DPhi", "=", 
   RowBox[{"Phi", ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"JacobianMtx", "[", 
      RowBox[{
       RowBox[{"F", "[", "x", "]"}], ",", "x"}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Phi0", "=", 
   RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xT", ",", "PhiT"}], "}"}], "=", 
   RowBox[{"IntVarEq", "[", 
    RowBox[{
     RowBox[{"F", "[", "x", "]"}], ",", "DPhi", ",", "x", ",", "Phi", ",", 
     "x0", ",", "Phi0", ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", "stepsize"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "xT", "\[IndentingNewLine]", 
 RowBox[{"PhiT", " ", "//", " ", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Random", "[", "]"}], ",", 
     RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Log", "[", 
   RowBox[{"Norm", "[", 
    RowBox[{"PhiT", ".", "u"}], "]"}], "]"}], "/", 
  "T"}], "\[IndentingNewLine]"}], "Input",
