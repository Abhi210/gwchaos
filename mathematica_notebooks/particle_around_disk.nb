     "w", 
     RowBox[{"(", "0", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w0", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", "6"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Normalize", " ", "w", 
     RowBox[{"(", "0", ")"}], " ", "to", " ", "make", " ", "it", " ", "a", 
